{
  "name": "armory",
  "private": true,
  "type": "module",
  "description": "Armory: a hub of peer-to-peer webtools on nostr, built on kiwi-framework. Shared lists, file drops, a noticeboard and games, all in the browser, synced over relays you choose.",
  "license": "GPL-3.0-or-later",
  "repository": "github:derlocke-ng/armory",
  "homepage": "https://derlocke-ng.github.io/armory/",
  "scripts": {
    "build": "node node_modules/kiwi-framework/scripts/build-site.mjs",
    "serve": "node node_modules/kiwi-framework/scripts/serve.mjs _site",
    "dev": "node node_modules/kiwi-framework/scripts/dev.mjs",
    "relay:nostr": "node node_modules/kiwi-framework/scripts/nostr-relay.mjs 7777 .nostr",
    "relay": "node node_modules/kiwi-framework/scripts/relay.cjs",
    "icons": "node node_modules/kiwi-framework/scripts/app-icons.mjs",
    "new-app": "node node_modules/kiwi-framework/scripts/new-app.mjs",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "node test/e2e/loadout.mjs && node test/e2e/hub.mjs && node test/e2e/devboard.mjs && node test/e2e/payload.mjs && node test/e2e/pong.mjs",
    "probe": "node node_modules/kiwi-framework/scripts/blossom-probe.mjs"
  },
  "dependencies": {
    "kiwi-framework": "git+https://github.com/derlocke-ng/kiwi-framework.git#3118c5ae6a5b82376844a53c621af7dcb03973b2"
  },
  "devDependencies": {
    "gun": "0.2020.1241",
    "nostr-tools": "^2.25.2",
    "playwright-core": "1.63.0"
  }
}
